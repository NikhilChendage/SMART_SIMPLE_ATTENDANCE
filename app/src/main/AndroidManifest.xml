<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.S_A">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".HodDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".TeacherDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".SessionsActivity"
            android:exported="false" />

        <activity
            android:name=".TeacherSessionsActivity"
            android:exported="false" />

        <activity
            android:name=".SessionYearsActivity"
            android:exported="false" />

        <activity
            android:name=".SessionDivisionsActivity"
            android:exported="false" />

        <activity
            android:name=".StudentYearsActivity"
            android:exported="false" />

        <activity
            android:name=".StudentDivisionsActivity"
            android:exported="false" />

        <activity
            android:name=".AttendanceAnalyticsActivity"
            android:exported="false" />

        <activity
            android:name=".SubjectListActivity"
            android:exported="false" />

        <activity
            android:name=".SubjectAnalyticsActivity"
            android:exported="false" />

        <activity
            android:name=".StudentAnalyticsActivity"
            android:exported="false" />

        <activity
            android:name=".CreateSessionActivity"
            android:exported="false" />

        <activity
            android:name=".StudentManagementActivity"
            android:exported="false" />

        <activity
            android:name=".StudentAttendanceActivity"
            android:exported="false" />

        <activity
            android:name=".TimeTableListActivity"
            android:exported="false" />

        <activity
            android:name=".TimeTableEditorActivity"
            android:exported="false" />

        <activity
            android:name=".FacultyManagementActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>