<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Academic Portal"
                android:textColor="#B0C4DE"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/imgProfile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#FFFFFF"
                android:text="👤"
                android:textSize="22sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txtDashboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage academic sessions, timetable, and students"
            android:textColor="#E0E7FF"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:rowOrderPreserved="false">

            <!-- Sessions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSessions"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="📚\nSessions"
                android:textColor="#1F2937"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                app:cornerRadius="16dp"
                android:elevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                style="?attr/materialButtonOutlinedStyle" />

            <!-- Manage Students -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageStudents"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="👨‍🎓\nManage Students"
                android:textColor="#1F2937"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                app:cornerRadius="16dp"
                android:elevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                style="?attr/materialButtonOutlinedStyle" />

            <!-- Manage Time Table -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTimeTable"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="📅\nManage Time Table"
                android:textColor="#1F2937"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                app:cornerRadius="16dp"
                android:elevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                style="?attr/materialButtonOutlinedStyle" />

            <!-- Manage Faculty -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageFaculty"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="👥\nManage Faculty"
                android:textColor="#1F2937"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                app:cornerRadius="16dp"
                android:elevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                style="?attr/materialButtonOutlinedStyle" />

        </GridLayout>
    </ScrollView>
</LinearLayout>
