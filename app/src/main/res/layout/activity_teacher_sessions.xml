<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Assigned Sessions"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTeacherSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sessions assigned by HOD &amp; created by you"
            android:textColor="@color/primary_light"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tabs Section (Flow: Today -> Upcoming -> Past Sessions -> All Sessions) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:scrollbars="none"
        android:elevation="2dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- 1. Today (Selected by Default) -->
            <TextView
                android:id="@+id/txtTabToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:paddingEnd="24dp" />

            <!-- 2. Upcoming -->
            <TextView
                android:id="@+id/txtTabUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming"
                android:textColor="@color/text_secondary"
                android:paddingEnd="24dp" />

            <!-- 3. Past Sessions -->
            <TextView
                android:id="@+id/txtTabPast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Past Sessions"
                android:textColor="@color/text_secondary"
                android:paddingEnd="24dp" />

            <!-- 4. All Sessions -->
            <TextView
                android:id="@+id/txtTabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Sessions"
                android:textColor="@color/text_secondary"
                android:paddingEnd="24dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Create Session Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenCreateSession"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:backgroundTint="@color/primary"
        android:text="+ Create New Session"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        app:cornerRadius="14dp"
        android:elevation="4dp" />

    <!-- Scrollable Sessions Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/teacherSessionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
