<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/txtTtHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Table Editor"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configure period structure and schedule"
            android:textColor="@color/primary_light"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTt"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/success"
            android:text="Save Sheet"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:elevation="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRow"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/primary"
            android:text="+ Add Period"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:elevation="3dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TableLayout
                android:id="@+id/tableTimeTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/card_background"
                android:elevation="2dp"
                android:stretchColumns="*"
                android:padding="12dp" />

        </ScrollView>
    </HorizontalScrollView>
</LinearLayout>
