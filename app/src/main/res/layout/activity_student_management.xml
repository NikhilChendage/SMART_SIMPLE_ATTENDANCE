<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Management"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enrolled Student Records &amp; Attendance Logs"
            android:textColor="@color/primary_light"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Sort Options Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:scrollbars="none"
        android:elevation="2dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/txtSortRollAsc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll No (1 ➔ N)"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:paddingEnd="24dp" />

            <TextView
                android:id="@+id/txtSortRollDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll No (N ➔ 1)"
                android:textColor="@color/text_secondary"
                android:paddingEnd="24dp" />

            <TextView
                android:id="@+id/txtSortNameAsc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name (A ➔ Z)"
                android:textColor="@color/text_secondary"
                android:paddingEnd="24dp" />

            <TextView
                android:id="@+id/txtSortNameDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name (Z ➔ A)"
                android:textColor="@color/text_secondary"
                android:paddingEnd="24dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Pinned Action Controls (Search, Add, Import, Delete Selected) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:background="@color/card_background"
        android:elevation="3dp"
        android:layout_marginBottom="2dp">

        <!-- Search Field with Icon -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search student / GNR / roll no"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/text_secondary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            android:layout_marginBottom="5dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddStudent"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/primary"
                android:text="+ Add Student"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:elevation="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/success"
                android:text="Import List"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:elevation="2dp" />
        </LinearLayout>

        <!-- Selection Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cbSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select All"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteSelected"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/error"
                android:text="Delete Selected"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Student List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/studentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>
</LinearLayout>
