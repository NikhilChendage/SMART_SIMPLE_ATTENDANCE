<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create New Session"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Schedule lectures, practicals, or tutorials"
            android:textColor="@color/primary_light"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subject -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Name"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etSubject"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Enter subject name"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Assigned Faculty / Teacher -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned Faculty / Teacher"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerFaculty"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/spinner_background"
                android:layout_marginBottom="16dp" />

            <!-- Session Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session Type"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerSessionType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/spinner_background"
                android:layout_marginBottom="16dp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Select Date (YYYY-MM-DD)"
                android:focusable="false"
                android:clickable="true"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day: -"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Year -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Academic Year"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerYear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/spinner_background"
                android:layout_marginBottom="16dp" />

            <!-- Division -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Division"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerDivision"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/spinner_background"
                android:layout_marginBottom="16dp" />

            <!-- Batch (Visible only when Practical is selected) -->
            <TextView
                android:id="@+id/lblBatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batch"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerBatch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/spinner_background"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Start Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Time"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Select Start Time"
                android:focusable="false"
                android:clickable="true"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- End Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Time"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Select End Time"
                android:focusable="false"
                android:clickable="true"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Room / Lab -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room / Lab"
                android:textColor="#374151"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etRoom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Enter room / lab"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="24dp" />

            <!-- Create Session Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateSession"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/primary"
                android:text="CREATE SESSION"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:elevation="4dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
